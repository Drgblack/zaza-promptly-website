# Zaza Promptly Production Environment Variables
# Use this as a template for production deployment

# ==============================================
# REQUIRED PRODUCTION VARIABLES
# ==============================================

# Application Environment
NODE_ENV=production

# Production Domain
NEXT_PUBLIC_APP_URL=https://zazapromptly.com

# ==============================================
# STRIPE PRODUCTION CONFIGURATION
# ==============================================
# CRITICAL: Use LIVE keys for production
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_secret

# ==============================================
# BREVO EMAIL CONFIGURATION
# ==============================================
BREVO_API_KEY=xkeysib-your_production_brevo_api_key
BREVO_LIST_ID=your_production_brevo_list_id

# ==============================================
# ANALYTICS & TRACKING
# ==============================================
# Google Analytics Production ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-YOUR_PRODUCTION_GA_ID

# ==============================================
# AI SERVICE APIS
# ==============================================
# OpenAI for AI features
OPENAI_API_KEY=sk-your_production_openai_api_key

# Optional: Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your_production_anthropic_key

# ==============================================
# SECURITY & PERFORMANCE
# ==============================================
# Strong JWT secret for production
JWT_SECRET=your_super_secure_production_jwt_secret_minimum_32_chars

# Production rate limiting (more restrictive)
RATE_LIMIT_MAX=60

# ==============================================
# ERROR TRACKING & MONITORING
# ==============================================
# Sentry for production error tracking
SENTRY_DSN=https://your_production_sentry_dsn@sentry.io/project_id
SENTRY_ORG=your_sentry_organization
SENTRY_PROJECT=zaza-promptly-production

# ==============================================
# DEPLOYMENT VERIFICATION
# ==============================================
# Set these to verify production deployment
DEPLOYMENT_STAGE=production
LAST_DEPLOYED=$(date)
BUILD_VERSION=1.0.0

# ==============================================
# OPTIONAL PRODUCTION FEATURES
# ==============================================
# Vercel Analytics (auto-detected on Vercel)
# VERCEL_ANALYTICS_ID=your_vercel_analytics_id

# Custom domain verification
# DOMAIN_VERIFICATION_TOKEN=your_domain_verification_token