# App Configuration
NEXT_PUBLIC_SITE_URL=https://www.zazapromptly.com
NEXT_PUBLIC_ENV=development

# Stripe Configuration
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PRICE_ID_PROMPTLY_MONTHLY=price_your_monthly_price_id_here
STRIPE_PRICE_ID_PROMPTLY_ANNUAL=price_your_annual_price_id_here

# Legacy Stripe (deprecated - use above instead)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_PRICE_ID_BASIC=price_your_basic_price_id_here
STRIPE_PRICE_ID_PRO=price_your_pro_price_id_here
STRIPE_PRICE_ID_PREMIUM=price_your_premium_price_id_here

# Database (if needed)
DATABASE_URL=your_database_connection_string_here

# Email Service (if needed)  
EMAIL_SERVER_HOST=your_email_server_host
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email_username
EMAIL_SERVER_PASSWORD=your_email_password
EMAIL_FROM=noreply@zazapromptly.com

# Analytics (if needed) - Choose one or more
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Legacy Analytics (deprecated - use above instead)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
NEXT_PUBLIC_HOTJAR_ID=your_hotjar_id

# Sentry Configuration
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1

# Feature Flags
NEXT_PUBLIC_ENABLE_WAITLIST=true
NEXT_PUBLIC_ENABLE_CHECKOUT=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false