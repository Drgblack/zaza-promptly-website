{
  "name": "promptly-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-search-index.js && tsx scripts/build-resources-meta.ts && next build && next-sitemap",
    "build:search": "node scripts/build-search-index.js",
    "build:resources": "tsx scripts/build-resources-meta.ts",
    "start": "next start",
    "lint": "next lint",
    "content:qa": "node scripts/content-qa.js",
    "check:links": "node scripts/check-links.js",
    "postbuild": "next-sitemap",
    "test": "jest",
    "test:smoke": "jest scripts/snippet-smoke.test.ts",
    "test:smoke:manual": "npx ts-node scripts/snippet-smoke.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:downloads": "tsx scripts/verify-downloads.ts",
    "generate:pdfs": "tsx scripts/generate-pdfs.ts",
    "build:full": "node scripts/build-search-index.js && npx playwright install chromium --with-deps && tsx scripts/generate-pdfs.ts && tsx scripts/build-resources-meta.ts && next build && next-sitemap"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "marked": "^16.2.0",
    "next": "14.2.8",
    "next-sitemap": "^4.2.3",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^18.4.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@jest/globals": "^29.7.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.5.0",
    "@playwright/test": "^1.55.0",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "broken-link-checker": "^0.7.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.8",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5"
  }
}
