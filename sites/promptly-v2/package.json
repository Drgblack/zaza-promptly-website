{
  "name": "promptly-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-search-index.js && tsx scripts/build-resources-meta.ts && next build",
    "build:search": "node scripts/build-search-index.js",
    "build:resources": "tsx scripts/build-resources-meta.ts",
    "start": "next start",
    "lint": "next lint",
    "content:qa": "node scripts/content-qa.js",
    "content:validate-faq": "node scripts/validate-faq-frontmatter.js",
    "check:links": "node scripts/check-links.cjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "postbuild": "next-sitemap",
    "test": "jest",
    "test:smoke": "jest scripts/snippet-smoke.test.ts",
    "test:smoke:manual": "npx ts-node scripts/snippet-smoke.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:downloads": "tsx scripts/verify-downloads.ts",
    "generate:pdfs": "tsx scripts/generate-pdfs.ts",
    "build:full": "node scripts/build-search-index.js && npx playwright install chromium --with-deps && tsx scripts/generate-pdfs.ts && tsx scripts/build-resources-meta.ts && next build && next-sitemap",
    "audit:links": "linkinator ${AUDIT_URL:-http://localhost:3000} --recurse --verbosity error",
    "audit:axe": "axe ${AUDIT_URL:-http://localhost:3000} --exit 0",
    "audit:lhci": "lhci autorun",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:seo": "node scripts/audit-seo.mjs"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.6.1",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^14.2.8",
    "@radix-ui/react-switch": "^1.2.6",
    "@sentry/nextjs": "^10.5.0",
    "@zaza/shared-brand": "file:./packages/shared-brand",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "fuse.js": "^7.1.0",
    "glob": "^11.0.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.541.0",
    "marked": "^16.2.0",
    "negotiator": "^1.0.0",
    "next": "14.2.8",
    "next-intl": "^4.3.5",
    "next-sitemap": "^4.2.3",
    "react": "^18",
    "react-dom": "^18",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "stripe": "^18.4.0",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.5",
    "use-intl": "^4.3.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.2",
    "@axe-core/playwright": "^4.10.2",
    "@jest/globals": "^29.7.0",
    "@lhci/cli": "^0.15.1",
    "@mdx-js/loader": "^3.1.0",
    "@playwright/test": "^1.55.0",
    "@types/jest": "^29.5.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "broken-link-checker": "^0.7.8",
    "cspell": "^9.2.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.8",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "linkinator": "^6.1.4",
    "postcss": "^8",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
