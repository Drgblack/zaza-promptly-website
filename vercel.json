{
  "buildCommand": "cd sites/promptly-v2 && npm ci && npm run build",
  "outputDirectory": "sites/promptly-v2/.next",
  "installCommand": "cd sites/promptly-v2 && npm ci",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "/$1",
      "permanent": false
    }
  ]
}